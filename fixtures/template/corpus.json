    {"name":"injected-date","template":"{{@date|date:%d/%m/%Y}}","fields":{},"locale":"fr-FR","date":"2024-02-29","output":"29/02/2024"},
    {"name":"bare-missing-is-error","template":"{{missing}}","fields":{},"locale":"en","date":"1970-01-01","error":"unknown field: missing"},
    {"name":"invalid-date-is-error","template":"{{@date|date:%Y}}","fields":{},"locale":"en","date":"2023-02-29","error":"invalid numeric/date value: 2023-02-29"}
  ]
